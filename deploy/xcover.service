[Unit]
Description=xCover pricing agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/xcover
EnvironmentFile=/home/ubuntu/xcover/.env
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/ubuntu/xcover/packages/agent/dist/src/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/xcover/data

[Install]
WantedBy=multi-user.target
