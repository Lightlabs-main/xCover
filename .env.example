# xCover environment. Copy to .env and fill in. Never commit .env.

# --- Chains -------------------------------------------------------------
# X Layer mainnet, chain id 196 (0xc4). Aave V3 lives here.
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
# Fallback if the primary is congested. Both are rate limited to 100 rps per IP.
XLAYER_MAINNET_RPC_FALLBACK=https://xlayerrpc.okx.com

# X Layer testnet, chain id 1952 (0x7a0) — NOT 195, which is deprecated.
# Aave V3 is not deployed here; the testnet deployment runs TestnetVenue.
# See docs/chain-verification.md.
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech

# --- Deployment ---------------------------------------------------------
# Deployer key. Testnet and mainnet keys should be different keys.
DEPLOYER_PRIVATE_KEY=
# OKLink key for contract verification on the X Layer explorer.
OKLINK_API_KEY=

# --- Pricing agent ------------------------------------------------------
ANTHROPIC_API_KEY=
# Key the agent signs quotes with. This key can only produce prices and
# refusals — it can never move money or alter a claim outcome (spec 4.7).
PRICER_PRIVATE_KEY=
# Seconds a quote stays valid before the policy mint must re-request one.
QUOTE_TTL_SECONDS=180
