# xCover environment. Copy to .env and fill in. Never commit .env.

# --- Chains -------------------------------------------------------------
# X Layer mainnet, chain id 196 (0xc4). Aave V3 lives here.
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
# Fallback if the primary is congested. Both are rate limited to 100 rps per IP.
XLAYER_MAINNET_RPC_FALLBACK=https://xlayerrpc.okx.com

# X Layer testnet, chain id 1952 (0x7a0) — NOT 195, which is deprecated.
# Aave V3 is not deployed here; the testnet deployment runs TestnetVenue.
# See docs/chain-verification.md.
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech

# --- Deployment ---------------------------------------------------------
# Deployer key. Testnet and mainnet keys should be different keys.
DEPLOYER_PRIVATE_KEY=
# OKLink key for contract verification on the X Layer explorer.
OKLINK_API_KEY=

# --- Pricing agent ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Key the agent signs quotes with. This key can only produce prices and
# refusals — it can never move money or alter a claim outcome (spec 4.7).
PRICER_PRIVATE_KEY=
# Required pricing controls. Benchmark-derived and reviewed runtime controls are
# intentionally blank; the agent refuses to start with guessed values.
PRICING_ENGINE_VERSION=pricing-1.0.0/xlayer-usdt
PRICING_CONFIDENCE_THRESHOLD_BPS=
PRICING_MAX_ENSEMBLE_DISAGREEMENT_BPS=
PRICING_MAX_UNCERTAINTY_LOADING_BPS=
PRICING_CAPITAL_COST_MARGIN_BPS=
PRICING_ORACLE_MAX_AGE_SECONDS=
PRICING_ORACLE_MAX_DEVIATION_BPS=
# Spec-defined contract term: $0.97 at 8 oracle decimals.
PRICING_DEPEG_LOWER_BOUND_8DP=97000000
PRICING_MAX_PREMIUM_RATE_RAY=

# Seconds or blocks a quote stays valid before the policy mint must re-request one.
QUOTE_TTL_SECONDS=180
# If set, this takes precedence over QUOTE_TTL_SECONDS and avoids a block-time assumption.
# QUOTE_TTL_BLOCKS=
# Required when QUOTE_TTL_BLOCKS is not set.
# XLAYER_BLOCK_TIME_SECONDS=
